{
  "manifest_version": 1,
  "type": "device",
  "name": "EMSC Earthquakes",
  "description": {
    "en": "Live earthquakes near your home from EMSC-CSEM: magnitude, distance, triggers and a widget.",
    "fr": "Les séismes proches de chez vous en direct, par l'EMSC-CSEM : magnitude, distance, scènes, widget.",
    "de": "Erdbeben in deiner Nähe live vom EMSC-CSEM: Magnitude, Entfernung, Szenen und ein Widget.",
    "es": "Terremotos cercanos a su casa en directo, del EMSC-CSEM: magnitud, distancia, escenas y widget."
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/guim31/gladys-emsc:1.0.0",
  "gladys_version": ">=5.1.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-emsc/main/cover.png",
  "categories": ["environment", "security"],
  "transports": ["cloud"],
  "location": true,
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Your zone",
        "fr": "Votre zone",
        "de": "Dein Gebiet",
        "es": "Su zona"
      },
      "description": {
        "en": "The earthquakes EMSC-CSEM reports around your house (or around coordinates), live. Choose a radius and a minimum magnitude, and optionally a wider zone for strong earthquakes only. Save, then create the device in the Discover tab.",
        "fr": "Les séismes signalés par l'EMSC-CSEM autour de votre maison (ou de coordonnées), en direct. Choisissez un rayon et une magnitude minimale, et si vous le voulez une zone plus large pour les seuls séismes forts. Enregistrez, puis créez l'appareil dans l'onglet Découverte.",
        "de": "Die vom EMSC-CSEM gemeldeten Erdbeben rund um dein Haus (oder um Koordinaten), live. Wähle einen Radius und eine Mindestmagnitude, und auf Wunsch eine weitere Zone nur für starke Beben. Speichere und lege dann das Gerät im Tab „Entdecken“ an.",
        "es": "Los terremotos que el EMSC-CSEM señala alrededor de su casa (o de unas coordenadas), en directo. Elija un radio y una magnitud mínima y, si lo desea, una zona más amplia solo para los terremotos fuertes. Guarde y cree el dispositivo en la pestaña Descubrir."
      },
      "links": [
        {
          "url": "https://github.com/guim31/gladys-emsc/blob/main/docs/en.md",
          "label": {
            "en": "Setup guide",
            "fr": "Guide d'installation",
            "de": "Installationsanleitung",
            "es": "Guía de instalación"
          }
        }
      ]
    },
    {
      "key": "about",
      "type": "section",
      "label": {
        "en": "Sources and limits",
        "fr": "Sources et limites",
        "de": "Quellen und Grenzen",
        "es": "Fuentes y límites"
      },
      "description": {
        "en": "Data © EMSC-CSEM, read without an account through its real-time feed. Not an early warning system: an earthquake is reported minutes after it happens. Not affiliated with EMSC.",
        "fr": "Données © EMSC-CSEM, lues sans compte par son flux temps réel. Pas un système d'alerte précoce : un séisme est signalé quelques minutes après. Non affiliée à l'EMSC.",
        "de": "Daten © EMSC-CSEM, ohne Konto über den Echtzeit-Feed gelesen. Kein Frühwarnsystem: Ein Erdbeben wird erst Minuten danach gemeldet. Nicht mit dem EMSC verbunden.",
        "es": "Datos © EMSC-CSEM, leídos sin cuenta mediante su flujo en tiempo real. No es un sistema de alerta temprana: un terremoto se señala minutos después. Sin afiliación con el EMSC."
      },
      "links": [
        {
          "url": "https://www.emsc-csem.org",
          "label": {
            "en": "EMSC website",
            "fr": "Site de l'EMSC",
            "de": "Website des EMSC",
            "es": "Sitio web del EMSC"
          }
        },
        {
          "url": "https://www.seismicportal.eu/realtime.html",
          "label": {
            "en": "Real-time feed",
            "fr": "Flux temps réel",
            "de": "Echtzeit-Feed",
            "es": "Flujo en tiempo real"
          }
        },
        {
          "url": "https://www.seismicportal.eu/terms.html",
          "label": {
            "en": "EMSC terms of use (CC BY 4.0)",
            "fr": "Conditions d'utilisation de l'EMSC (CC BY 4.0)",
            "de": "Nutzungsbedingungen des EMSC (CC BY 4.0)",
            "es": "Condiciones de uso del EMSC (CC BY 4.0)"
          }
        }
      ]
    },
    {
      "key": "latitude",
      "type": "string",
      "label": {
        "en": "Centre latitude",
        "fr": "Latitude du centre",
        "de": "Breitengrad des Mittelpunkts",
        "es": "Latitud del centro"
      },
      "description": {
        "en": "Leave both coordinates empty to use the location of your house in Gladys.",
        "fr": "Laissez les deux coordonnées vides pour utiliser la position de votre maison dans Gladys.",
        "de": "Lass beide Koordinaten leer, um den Standort deines Hauses in Gladys zu verwenden.",
        "es": "Deje ambas coordenadas vacías para usar la ubicación de su casa en Gladys."
      },
      "placeholder": {
        "en": "e.g. 43.6045",
        "fr": "ex. 43,6045",
        "de": "z. B. 43.6045",
        "es": "p. ej. 43.6045"
      },
      "required": false,
      "default": ""
